# Copy to .env; never commit real credentials.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
YARAXGUI_API_KEY=change-me-to-a-long-random-string
# Site hostname or LAN IPv4 address clients will use, without scheme or port.
# For example, set YARAXGUI_DOMAIN=192.168.1.50 to connect by LAN IP over HTTPS.
# Never use 0.0.0.0 or :: here: those are listen addresses, not site names.
# For LAN HTTPS using an IP or local hostname, clients must trust Caddy's local CA;
# see docs/API_SECURITY.md. Published ports already listen on all interfaces.
YARAXGUI_DOMAIN=yara.example.com
# Windows / Docker Desktop: scripts/compose.bat selects persistent Docker
# storage automatically. Linux: use scripts/compose.sh (uses DATA_DIR).
# For a Windows bind mount instead, set YARAXGUI_DATA_DIR=./server-data and create its
# uploads/ and samples/ folders first. See docs/API_SECURITY.md.
# Linux: existing data location is preserved. Only samples/ and uploads/ are readable
# by file/scan endpoints. rules.db remains at the data directory root.
YARAXGUI_DATA_DIR=/mnt/exthdd/yaraxgui-data
YARAXGUI_CORS_ORIGINS=
YARAXGUI_MAX_UPLOAD_MB=100
YARAXGUI_UPLOAD_QUOTA_MB=1024
# Optional fixed HTTPS MWDB API origin; blank disables server-side MWDB scans.
YARAXGUI_MWDB_URL=
